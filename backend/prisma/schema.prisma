generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [pgvector(map: "vector")]
}

model MenuItem {
  id          String   @id @default(uuid())
  name        String
  category    String
  price       Decimal  @db.Decimal(10, 2)
  description String?
  imageUrl    String?
  tags        String[]
  allergens   String[]
  available   Boolean  @default(true)
  popularScore Float   @default(0)
  embedding   Unsupported("vector(384)")?  // ← add this
  cartItems   CartItem[]
  orderItems  OrderItem[]
  createdAt   DateTime @default(now())
  translations MenuTranslation[]
  inventory   Inventory?
  restaurantId String?
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id])
}

model Session {
  id                  String     @id @default(uuid())
  tableId             String
  status              String     @default("active") // active | ordered | closed
  preferences         Json       @default("{}")
  conversationSummary String?
  cartItems           CartItem[]
  orders              Order[]
  createdAt           DateTime   @default(now())
  expiresAt           DateTime
  customerPhone String?
  restaurantId String?
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id])
}

model CartItem {
  id                 String    @id @default(uuid())
  sessionId          String
  menuItemId         String
  quantity           Int       @default(1)
  specialInstructions String?
  addedBy            String?
  session            Session   @relation(fields: [sessionId], references: [id])
  menuItem           MenuItem  @relation(fields: [menuItemId], references: [id])
  createdAt          DateTime  @default(now())
}

model Order {
  id             String      @id @default(uuid())
  sessionId      String
  customerName   String
  customerPhone  String
  status         String      @default("pending")
  totalAmount    Decimal     @db.Decimal(10, 2)
  taxAmount      Decimal     @db.Decimal(10, 2)
  session        Session     @relation(fields: [sessionId], references: [id])
  orderItems     OrderItem[]
  createdAt      DateTime    @default(now())
  delivery    Delivery?
  paymentMethod String? @default("cash")
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  menuItemId  String
  quantity    Int
  price       Decimal  @db.Decimal(10, 2)
  order       Order    @relation(fields: [orderId], references: [id])
  menuItem    MenuItem @relation(fields: [menuItemId], references: [id])
}

model CustomerProfile {
  id           String   @id @default(uuid())
  phone        String   @unique
  name         String?
  preferences  Json     @default("{}")
  orderCount   Int      @default(0)
  totalSpent   Float    @default(0)
  lastVisit    DateTime @default(now())
  createdAt    DateTime @default(now())
}

model Coupon {
  id          String   @id @default(uuid())
  code        String   @unique
  discount    Float
  type        String   @default("percentage")
  minOrder    Float    @default(0)
  maxUses     Int      @default(100)
  usedCount   Int      @default(0)
  active      Boolean  @default(true)
  expiresAt   DateTime?
  createdAt   DateTime @default(now())
}

model LoyaltyAccount {
  id          String   @id @default(uuid())
  phone       String   @unique
  points      Int      @default(0)
  totalEarned Int      @default(0)
  totalRedeemed Int    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  transactions LoyaltyTransaction[]
}

model LoyaltyTransaction {
  id        String   @id @default(uuid())
  phone     String
  points    Int
  type      String   // earned | redeemed
  orderId   String?
  note      String?
  createdAt DateTime @default(now())
  account   LoyaltyAccount @relation(fields: [phone], references: [phone])
}

model Reservation {
  id          String   @id @default(uuid())
  name        String
  phone       String
  tableId     String
  date        String
  time        String
  guests      Int      @default(2)
  status      String   @default("confirmed")
  note        String?
  createdAt   DateTime @default(now())
}

model MenuTranslation {
  id          String   @id @default(uuid())
  menuItemId  String
  language    String   // hi | te | en
  name        String
  description String?
  menuItem    MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  @@unique([menuItemId, language])
}

model DietaryProfile {
  id              String   @id @default(uuid())
  phone           String   @unique
  conditions      String[] // diabetic, hypertensive, celiac
  dietType        String?  // vegan, vegetarian, keto, halal, jain
  allergies       String[] // nuts, dairy, gluten, shellfish, eggs
  preferences     String[] // spicy, mild, light, filling
  avoidIngredients String[]
  calories        Int?     // daily calorie target
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Inventory {
  id          String   @id @default(uuid())
  menuItemId  String   @unique
  stock       Int      @default(0)
  lowStockAt  Int      @default(10)
  trackStock  Boolean  @default(false)
  updatedAt   DateTime @updatedAt
  menuItem    MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
}

model Staff {
  id          String   @id @default(uuid())
  name        String
  email       String   @unique
  password    String
  role        String   @default("cashier") // owner | manager | cashier | kitchen
  active      Boolean  @default(true)
  lastLogin   DateTime?
  createdAt   DateTime @default(now())
}

model Restaurant {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  address     String?
  phone       String?
  logo        String?
  theme       Json      @default("{}")
  active      Boolean   @default(true)
  ownerId     String?
  createdAt   DateTime  @default(now())
  sessions    Session[]
  menuItems   MenuItem[]
}

model Delivery {
  id           String   @id @default(uuid())
  orderId      String   @unique
  driverName   String
  driverPhone  String
  status       String   @default("assigned") // assigned | picked_up | on_way | delivered
  lat          Float?
  lng          Float?
  estimatedMin Int      @default(30)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  order        Order    @relation(fields: [orderId], references: [id])
}